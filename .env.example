# .env.example  -> copy to .env and fill in. Never commit .env.
GFW_API_KEY=
DATA_DIR=./data
LOG_LEVEL=INFO
LOG_JSON=false

# Local PostgreSQL from compose.yaml (the loader uses DATABASE_URL, dbt uses the PG* variables)
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger
PGHOST=localhost
PGPORT=5432
PGUSER=ledger
PGPASSWORD=ledger
PGDATABASE=ledger
